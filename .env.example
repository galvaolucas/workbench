# Copy to .env and fill in. Dev only — see README for release builds.

# GitHub OAuth app client ID, device flow enabled. Not a secret: it ships
# inside the binary. There is no client secret in this app, by design.
WORKBENCH_GITHUB_CLIENT_ID=

# GitHub Enterprise Server, if you're not on github.com.
# WORKBENCH_GITHUB_HOST=https://ghe.your-co.com
